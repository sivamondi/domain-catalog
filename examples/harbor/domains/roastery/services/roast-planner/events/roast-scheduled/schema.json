{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "A batch containing this order has a roasting slot.",
  "required": [
    "batchId",
    "roastOn"
  ],
  "properties": {
    "batchId": {
      "type": "string"
    },
    "roastOn": {
      "type": "string",
      "format": "date"
    }
  }
}
