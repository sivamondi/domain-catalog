{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Asks for a card payment against an order.",
  "required": [
    "orderId",
    "amount"
  ],
  "properties": {
    "orderId": {
      "type": "string",
      "format": "uuid",
      "description": "The order number"
    },
    "amount": {
      "type": "integer",
      "description": "Amount in pence"
    }
  }
}
